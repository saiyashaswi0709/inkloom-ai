# Inkloom AI - Environment Configuration Example
# Copy this file to .env and provide your actual values

# Database Configuration (Render PostgreSQL or local fallback)
# Example: postgresql://inkloom_user:password@dpg-xxxxxx.oregon-postgres.render.com/inkloom_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkloom_ai

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (OpenRouter & NVIDIA Nemotron)
OPENROUTER_API_KEY=your-openrouter-api-key-here
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Frontend Integration
FRONTEND_URL=http://localhost:5173

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
